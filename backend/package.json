    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@supabase/supabase-js": "^2.110.0",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.5"
  }
